---
import { MAPLE_LEAF, leafTransform } from '../lib/maple-leaf';
import { isSafeHref } from '../lib/links';
import { INTRO, DEFAULT_THEME, run, type Context, type Line } from '../terminal/commands';
import { promptFor, envFor } from '../terminal/shells';

interface Props {
  ctx: Context;
}

const { ctx } = Astro.props;
const prompt = promptFor(DEFAULT_THEME);
const CHIPS = ['whoami', 'profiles', 'resume', 'contact', 'help'];

const isBlank = (line: Line) => !line.some((s) => s.text);
const intro = INTRO.map((cmd) => ({ cmd, lines: run(cmd, ctx, envFor(DEFAULT_THEME)).lines }));
---

<section class="terminal" role="region" aria-labelledby="term-title" data-terminal data-theme={DEFAULT_THEME} data-context={JSON.stringify(ctx)}>
  <div class="term-chrome">
    <svg class="term-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="18" height="18" aria-hidden="true" focusable="false"><path class="term-logo-brackets" d="M7 22V7h15M42 7h15v15M57 42v15H42M22 57H7V42" fill="none" stroke="#8da2ff" stroke-width="6"></path><path class="term-logo-leaf" transform={leafTransform(32, 32, 22)} d={MAPLE_LEAF} fill="#e0301e"></path></svg>
    <span class="term-title" id="term-title">icns consulting | terminal</span>
    <span class="term-dots" aria-hidden="true"><span></span><span></span><span></span></span>
  </div>
  <div class="term-body">
    <div class="term-output" data-term-output role="log" aria-live="polite" aria-label="Terminal output" tabindex="0">
      {
        intro.map(({ cmd, lines }) => (
          <>
            {prompt.pre && <div class="term-line term-pre"><span class="term-prompt">{prompt.pre.map((s) => (s.cls ? <span class={s.cls}>{s.text}</span> : s.text))}</span></div>}
            <div class="term-line term-echo"><span class="term-prompt">{prompt.main.map((s) => (s.cls ? <span class={s.cls}>{s.text}</span> : s.text))}</span> <span class="term-cmd">{cmd}</span></div>
            {lines.map((line) => (
              <div class:list={['term-line', { 'term-blank': isBlank(line) }]}>{line.map((seg) => (isSafeHref(seg.href) ? <a class="term-link" href={seg.href} rel={seg.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{seg.text}</a> : seg.text))}</div>
            ))}
          </>
        ))
      }
    </div>
    <div class="term-line term-idle" data-term-idle aria-hidden="true"><span class="term-prompt">{prompt.main.map((s) => (s.cls ? <span class={s.cls}>{s.text}</span> : s.text))}</span> <span class="term-cursor"></span></div>
    <div class="term-line term-pre" data-term-pre aria-hidden="true" hidden><span class="term-prompt"></span></div>
    <form class="term-form" data-term-form hidden>
      <span class="term-prompt" aria-hidden="true">{prompt.main.map((s) => (s.cls ? <span class={s.cls}>{s.text}</span> : s.text))}</span>
      <label class="visually-hidden" for="term-input">Terminal command</label>
      <input class="term-input" id="term-input" data-term-input type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" />
    </form>
  </div>
  <div class="term-chips" data-term-chips hidden>
    {CHIPS.map((c) => <button type="button" data-cmd={c}>{c}</button>)}
  </div>
</section>

<script>
  import { mountTerminal } from '../terminal/terminal';
  import type { Context } from '../terminal/commands';

  const root = document.querySelector<HTMLElement>('[data-terminal]');
  if (root) {
    let ctx: Context | null = null;
    try {
      ctx = JSON.parse(root.dataset.context ?? '') as Context;
    } catch {
      ctx = null;
    }
    if (ctx && Array.isArray(ctx.profiles) && typeof ctx.securityTxt === 'string') {
      const input = root.querySelector<HTMLInputElement>('[data-term-input]');
      root.querySelector('[data-term-idle]')?.setAttribute('hidden', '');
      root.querySelector('[data-term-form]')?.removeAttribute('hidden');
      root.querySelector('[data-term-chips]')?.removeAttribute('hidden');
      mountTerminal(root, ctx);
      // Clicking the screen (not a link, not a selection) puts the caret in the prompt.
      root.querySelector('.term-body')?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('a, button, input')) return;
        if (window.getSelection()?.toString()) return;
        input?.focus({ preventScroll: true });
      });
    }
  }
</script>
