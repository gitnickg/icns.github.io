---
import { INTRO, run, type Context, type Line } from '../terminal/commands';

interface Props {
  ctx: Context;
}

const { ctx } = Astro.props;
const PROMPT = 'visitor@icns.ca:~$';
const CHIPS = ['whoami', 'profiles', 'status', 'contact', 'help'];

// Same link rule as the live terminal: only https: and mailto: become links.
const linkable = (href?: string): href is string => {
  if (!href) return false;
  try {
    const p = new URL(href).protocol;
    return p === 'https:' || p === 'mailto:';
  } catch {
    return false;
  }
};
const isBlank = (line: Line) => !line.some((s) => s.text);
const intro = INTRO.map((cmd) => ({ cmd, lines: run(cmd, ctx).lines }));
---

<section class="terminal" role="region" aria-label="Interactive terminal" data-terminal data-theme="blue" data-context={JSON.stringify(ctx)}>
  <div class="term-chrome">
    <svg class="term-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="18" height="18" aria-hidden="true" focusable="false"><path d="M7 22V7h15M42 7h15v15M57 42v15H42M22 57H7V42" fill="none" stroke="#8da2ff" stroke-width="6"></path><circle cx="32" cy="32" r="7.5" fill="#e8ebf6"></circle></svg>
    <span class="term-title">visitor@icns.ca</span>
    <span class="term-dots" aria-hidden="true"><span></span><span></span><span></span></span>
  </div>
  <div class="term-body">
    <div class="term-output" data-term-output role="log" aria-live="polite" aria-label="Terminal output" tabindex="0">
      {
        intro.map(({ cmd, lines }) => (
          <>
            <div class="term-line term-echo"><span class="term-prompt">{PROMPT}</span> <span class="term-cmd">{cmd}</span></div>
            {lines.map((line) => (
              <div class:list={['term-line', { 'term-blank': isBlank(line) }]}>{line.map((seg) => (linkable(seg.href) ? <a class="term-link" href={seg.href} rel={seg.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{seg.text}</a> : seg.text))}</div>
            ))}
          </>
        ))
      }
    </div>
    <div class="term-line term-idle" data-term-idle aria-hidden="true"><span class="term-prompt">{PROMPT}</span> <span class="term-cursor"></span></div>
    <form class="term-form" data-term-form hidden>
      <span class="term-prompt" aria-hidden="true">{PROMPT}</span>
      <label class="visually-hidden" for="term-input">Terminal command</label>
      <input class="term-input" id="term-input" data-term-input type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" />
    </form>
  </div>
  <div class="term-chips" data-term-chips hidden>
    {CHIPS.map((c) => <button type="button" data-cmd={c}>{c}</button>)}
  </div>
</section>

<script>
  import { mountTerminal } from '../terminal/terminal';
  import type { Context } from '../terminal/commands';

  const root = document.querySelector<HTMLElement>('[data-terminal]');
  if (root) {
    let ctx: Context | null = null;
    try {
      ctx = JSON.parse(root.dataset.context ?? '') as Context;
    } catch {
      ctx = null;
    }
    if (ctx && Array.isArray(ctx.profiles) && typeof ctx.securityTxt === 'string') {
      const input = root.querySelector<HTMLInputElement>('[data-term-input]');
      root.querySelector('[data-term-idle]')?.setAttribute('hidden', '');
      root.querySelector('[data-term-form]')?.removeAttribute('hidden');
      root.querySelector('[data-term-chips]')?.removeAttribute('hidden');
      mountTerminal(root, ctx);
      // Clicking the screen (not a link, not a selection) puts the caret in the prompt.
      root.querySelector('.term-body')?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('a, button, input')) return;
        if (window.getSelection()?.toString()) return;
        input?.focus({ preventScroll: true });
      });
    }
  }
</script>
