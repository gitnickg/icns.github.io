---
import type { Profile } from '../lib/profiles';

interface Props {
  profiles: Profile[];
}

const { profiles } = Astro.props;
const display = (url: string) => url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section class="readable" id="about" data-readable aria-labelledby="about-title">
  <header class="readable-head">
    <h1 id="about-title">icns consulting inc.</h1>
    <p class="whoami">
      <span>Sr. Security Developer, CISSP | CCSP</span>
      <span>ai dev, system integrations &amp; automations</span>
      <span>Independent Consultant @ icns.ca</span>
    </p>
  </header>

  <p class="bio">
    I've spent 20 years in technology, 15 of them in security. I'm based in Halifax, Nova Scotia, and work remote only.
    icns consulting inc. is my company: I'm active in bug bounty programs and open to part-time consulting.
  </p>

  <div class="facts">
    <section class="fact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p><a class="contact-email" href="mailto:hello@icns.ca">hello@icns.ca</a></p>
    </section>

    <section class="fact" aria-labelledby="status-title">
      <h2 id="status-title">Status</h2>
      <ul>
        <li>Bug bounties: active</li>
        <li>Consulting: open, part-time, remote only</li>
      </ul>
    </section>

    <section class="fact" aria-labelledby="creds-title">
      <h2 id="creds-title">Credentials</h2>
      <ul>
        <li>CISSP (ISC2)</li>
        <li>CCSP (ISC2)</li>
        <li>Bachelor of Commerce, Saint Mary's University</li>
      </ul>
    </section>

    <section class="fact" aria-labelledby="profiles-title">
      <h2 id="profiles-title">Profiles</h2>
      <ul>
        {
          profiles.map((p) => (
            <li>
              {p.name}: <a href={p.url} rel="noopener noreferrer">{display(p.url)}</a>
              {p.stats && <span class="stats"> ({p.stats})</span>}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>
