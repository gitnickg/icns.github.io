---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Readable from '../components/Readable.astro';
import { loadProfiles } from '../lib/profiles';
import { readSecurityTxt } from '../lib/security-txt';

const profiles = await loadProfiles();
const ctx = { profiles, securityTxt: readSecurityTxt() };
---

<Base canonical="https://icns.ca/">
  <a class="skip-link" href="#about">Skip to readable version</a>
  <main class="page">
    <Terminal ctx={ctx} />
    <Readable profiles={profiles} />
  </main>
</Base>
