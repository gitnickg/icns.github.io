---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | icns" noindex>
  <main class="page not-found">
    <h1>Page not found</h1>
    <div class="terminal terminal-small" data-theme="blue">
      <div class="term-body">
        <div class="term-output">
          <div class="term-line term-echo"><span class="term-prompt">visitor@icns.ca:~$</span> <span class="term-cmd">open this-page</span></div>
          <div class="term-line">command not found: this-page</div>
        </div>
      </div>
    </div>
    <p><a href="/">cd ~ (back to icns.ca)</a></p>
  </main>
</Base>
